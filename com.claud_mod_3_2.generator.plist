<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.claud_mod_3_2.generator</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/irina/Desktop/claud_mod_3_2/scheduler.py</string>
        <string>--mode</string>
        <string>generate</string>
    </array>

    <!-- Run every day at 22:00 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>22</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/irina/Desktop/claud_mod_3_2/logs/generator.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/irina/Desktop/claud_mod_3_2/logs/generator.err.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/irina/Desktop/claud_mod_3_2</string>
</dict>
</plist>
