# Скопируй этот файл в .env и заполни реальными значениями.
# Файл .env не должен попадать в git.
# Все токены и ключи вноси самостоятельно — скиллы не пишут и не читают этот файл.

# ── Telegram Bot (@Div_content_bot или другой) ──
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL_ID=@your_channel_or_numeric_id

# ── VK ──
VK_ACCESS_TOKEN=your_vk_access_token_here
VK_GROUP_ID=your_vk_group_id_here

# VK ID OAuth 2.1 PKCE (для автоматического обновления access_token)
# Заполняется один раз после прохождения PKCE-авторизации.
VK_CLIENT_ID=your_vk_client_id_here
VK_REFRESH_TOKEN=your_vk_refresh_token_here
VK_DEVICE_ID=your_vk_device_id_here

# ── Qwen / DashScope (для генерации изображений) ──
QWEN_API_KEY=your_qwen_api_key_here
# Для Wan 2.6 на международном endpoint:
BASE_URL=https://dashscope-intl.aliyuncs.com
IMAGE_MODEL=wan2.6-t2i
# Альтернативно: wan2.5-t2i-preview (требуется endpoint /api/v1/services/aigc/text2image/image-synthesis)
